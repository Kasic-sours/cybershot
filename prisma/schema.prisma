generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:/data/database.db"
}

model User {
  id           String    @id @default(uuid())
  nickname     String    @unique
  token        String    @unique
  credits      Float     @default(100)
  energy       Float     @default(50)
  maxEnergy    Float     @default(50)
  shards       Int       @default(0)
  metal        Int       @default(100) // <--- НОВОЕ
  parts        Int       @default(20)  // <--- НОВОЕ
  level        Int       @default(1)
  exp          Int       @default(0)
  incomeLevel  Int       @default(1)
  promoUsed    Boolean   @default(false)
  lastIncome   DateTime  @default(now())
  lastDaily    DateTime?
  lastRoulette DateTime?
  playerClass  String?
  
  buildings    Building[]
  quests       UserQuest[]
  
  guildId      String?
  guildRole    String?
  guild        Guild?    @relation(fields: [guildId], references: [id])
  
  trades       TradeOffer[]
  messages     ChatMessage[]
}

model Building {
  id         String    @id @default(uuid())
  type       String
  level      Int       @default(1)
  upgrading  Boolean   @default(false)
  upgradeEnd DateTime?
  userId     String
  user       User      @relation(fields: [userId], references: [id])
}

model Guild {
  id      String @id @default(uuid())
  name    String @unique
  leader  String
  members User[]
}

model TradeOffer {
  id        String   @id @default(uuid())
  sellerId  String
  seller    User     @relation(fields: [sellerId], references: [id])
  resource  String
  amount    Float
  price     Float
  createdAt DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(uuid())
  text      String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model UserQuest {
  id        String @id @default(uuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id])
  questKey  String
  isDone    Boolean @default(false)
  isClaimed Boolean @default(false)
}